#. Plugin Name of the plugin
#: code-archive.php
msgid "Code Archive"
msgstr ""

#. Plugin URI of the plugin
#: code-archive.php
msgid "https://github.com/NeilWJames/code-archive"
msgstr ""

#. Description of the plugin
#: code-archive.php
msgid "Keeps inactive plugins out of the plugins folder by archiving them as zip files, and puts them back when they are needed. Archived plugins stay listed and can still be updated."
msgstr ""

#. Author of the plugin
#: code-archive.php
msgid "Neil James"
msgstr ""


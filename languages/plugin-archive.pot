#. Plugin Name of the plugin
#: plugin-archive.php
msgid "Plugin Archive"
msgstr ""

#. Plugin URI of the plugin
#: plugin-archive.php
msgid "https://github.com/NeilWJames/plugin-archive"
msgstr ""

#. Description of the plugin
#: plugin-archive.php
msgid "Keeps inactive plugins out of the plugins folder by archiving them as zip files, and puts them back when they are needed. Archived plugins stay listed and can still be updated."
msgstr ""

#. Author of the plugin
#: plugin-archive.php
msgid "Neil James"
msgstr ""


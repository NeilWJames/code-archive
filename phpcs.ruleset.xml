<?xml version="1.0"?>
<ruleset name="Code Archive">

	<extensions>php</extensions>

	<!-- Only the plugin's own text domain, as Plugin Check uses. Core strings reused as they are (no text domain)
	     are marked with phpcs:ignore WordPress.WP.I18n.MissingArgDomain on that line. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="code-archive"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="code_archive"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="PHPCompatibilityWP"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*.bak</exclude-pattern>
</ruleset>
